# Copy to .env and fill in. Never commit .env.
CRAWLBASE_NORMAL_TOKEN=
CRAWLBASE_JS_TOKEN=

# Optional: credits per month if the Account API does not return remainingCredits
# (pay-as-you-go accounts). Drives the "days to zero" panel and alert.
CRAWLBASE_MONTHLY_BUDGET=1000

# Account API product: crawling-api or crawler
ACCOUNT_PRODUCT=crawling-api

# Optional Enterprise Crawler stats (/crawler/<TOKEN>/stats)
CRAWLER_STATS_ENABLED=false

# Demo scraper: stops sending after this many requests, keeps serving /metrics
DEMO_MAX_REQUESTS=40
DEMO_INTERVAL=2
DEMO_WORKERS=4

GRAFANA_ADMIN_PASSWORD=admin
